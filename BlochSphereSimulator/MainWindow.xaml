<Window x:Class="BlochSphereSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="http://helix-toolkit.org/wpf"
        Title="Kvantum Bloch-gömb Szimulátor" Height="880" Width="1400" MinWidth="1050" MinHeight="680"
        Background="White" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Control" Command="{Binding UndoCommand}"/>
    </Window.InputBindings>

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="#111111"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.InitialShowDelay" Value="300"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E2E2"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#D0D0D0"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#AAAAAA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#2D2D2D"/>
            <Setter Property="Foreground" Value="White"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#444444"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#BBBBBB"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FBFBFB"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Width" Value="64"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Right"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#2D2D2D"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GroupBox">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="{TemplateBinding Header}" Margin="2,0,0,6" FontWeight="SemiBold" FontSize="14" Foreground="#1A1A1A"/>
                            <Border Grid.Row="1" Background="#F9F9F9" BorderBrush="#E5E5E5" BorderThickness="1" Padding="12">
                                <ContentPresenter/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="Margin" Value="0,1"/>
        </Style>

        <Style x:Key="Overlay" TargetType="Border">
            <Setter Property="Background" Value="#E6FFFFFF"/>
            <Setter Property="BorderBrush" Value="#BBBBBB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="16"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="450"/>
        </Grid.ColumnDefinitions>

        <!-- ===================== LEFT: 3D view + overlays ===================== -->
        <Grid Grid.Column="0" Background="#F3F3F3">
            <helix:HelixViewport3D x:Name="MainViewport" ZoomExtentsWhenLoaded="False"
                                   ShowCoordinateSystem="False" ShowViewCube="False" ShowCameraTarget="False" IsHeadLightEnabled="True">
                <helix:HelixViewport3D.Camera>
                    <PerspectiveCamera Position="6.0,2.2,2.8" LookDirection="-6.0,-2.2,-2.8" UpDirection="0,0,1" FieldOfView="40"/>
                </helix:HelixViewport3D.Camera>
                <helix:DefaultLights/>
            </helix:HelixViewport3D>

            <!-- 2D labels (axis names, step numbers, qubit names), positioned by projecting their 3D anchor points -->
            <Canvas x:Name="LabelCanvas" IsHitTestVisible="False" ClipToBounds="True"/>

            <!-- Live state readout -->
            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Top" MinWidth="380">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Ellipse Width="12" Height="12" Fill="{Binding SelectedQubit.Brush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock FontWeight="SemiBold" FontSize="14">
                            <Run Text="Aktuális állapot – "/><Run Text="{Binding SelectedQubit.Name, Mode=OneWay}"/>
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding FormulaText}" Style="{StaticResource Mono}"/>
                    <TextBlock Style="{StaticResource Mono}">
                        <Run Text="{Binding AlphaText, Mode=OneWay}"/><Run Text="     "/><Run Text="{Binding BetaText, Mode=OneWay}"/>
                    </TextBlock>
                    <TextBlock Text="{Binding AnglesText}" Style="{StaticResource Mono}"/>
                    <TextBlock Text="{Binding CoordinatesText}" Style="{StaticResource Mono}"/>
                    <TextBlock Text="{Binding ProbZText}" Style="{StaticResource Mono}" Margin="0,6,0,2"/>
                    <Grid Margin="0,2,0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="|0⟩" Style="{StaticResource Mono}"/>
                        <Border Grid.Column="1" Background="#E8E8E8" Width="200" Height="10" HorizontalAlignment="Left">
                            <Rectangle Fill="{Binding SelectedQubit.Brush}" Width="{Binding ProbBar0}" HorizontalAlignment="Left"/>
                        </Border>
                        <TextBlock Grid.Row="1" Text="|1⟩" Style="{StaticResource Mono}"/>
                        <Border Grid.Row="1" Grid.Column="1" Background="#E8E8E8" Width="200" Height="10" HorizontalAlignment="Left">
                            <Rectangle Fill="{Binding SelectedQubit.Brush}" Width="{Binding ProbBar1}" HorizontalAlignment="Left"/>
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding ProbXText}" Style="{StaticResource Mono}"/>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="α és β a globális fázis elhagyásával (α valós, nemnegatív), ahogy az előadáson."/>
                </StackPanel>
            </Border>

            <!-- Gate chain + history controls -->
            <Border Style="{StaticResource Overlay}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="520">
                <StackPanel>
                    <TextBlock FontWeight="SemiBold" FontSize="14" Margin="0,0,0,6">
                        <Run Text="Műveleti lánc – "/><Run Text="{Binding SelectedQubit.Name, Mode=OneWay}"/>
                    </TextBlock>
                    <ScrollViewer MaxHeight="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,6">
                        <TextBlock Text="{Binding SelectedQubit.ChainText}" TextWrapping="Wrap" FontFamily="Consolas" Foreground="#333"/>
                    </ScrollViewer>
                    <TextBlock Text="{Binding LastMeasurementText}" Foreground="#B00020" TextWrapping="Wrap" Margin="0,0,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="↶ Visszavonás (Ctrl+Z)" Command="{Binding UndoCommand}" ToolTip="Az utolsó kapu vagy mérés visszavonása"/>
                        <Button Content="Lánc törlése" Command="{Binding ClearCommand}" ToolTip="Vissza a kiválasztott qubit kezdőállapotához"/>
                        <Button Content="Nézet alaphelyzetbe" Click="ResetCamera_Click" ToolTip="Kamera visszaállítása"/>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Content="Animáció" IsChecked="{Binding AnimationEnabled}" Margin="0,0,14,4" VerticalAlignment="Center"/>
                        <TextBlock Text="Sebesség:" Foreground="#555" VerticalAlignment="Center" Margin="0,0,4,4"/>
                        <Slider Width="80" Minimum="0.2" Maximum="3" Value="{Binding AnimationSeconds}" IsDirectionReversed="True"
                                VerticalAlignment="Center" Margin="0,0,14,4" ToolTip="Animáció hossza (balra lassabb)"/>
                        <CheckBox Content="Korábbi állapotok" IsChecked="{Binding ShowHistory}" Margin="0,0,14,4" VerticalAlignment="Center"/>
                        <CheckBox Content="Pályák" IsChecked="{Binding ShowPaths}" Margin="0,0,0,4" VerticalAlignment="Center"/>
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                               Text="Forgatás: bal egérgomb · Mozgatás: jobb egérgomb · Nagyítás: görgő. A számok a lépések sorrendjét jelölik."/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ===================== RIGHT: controls ===================== -->
        <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1,0,0,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,18,20,18">
                    <TextBlock Text="Bloch-gömb Szimulátor" FontSize="24" FontWeight="Bold" Foreground="#111111"/>
                    <TextBlock Text="Kvantuminformatikai alkalmazások – egy kvantumbit állapotai és kapui" Style="{StaticResource Caption}" Margin="0,0,0,16"/>

                    <!-- Qubits -->
                    <GroupBox Header="Kvantumbitek (független állapotok)">
                        <StackPanel>
                            <ListBox ItemsSource="{Binding Qubits}" SelectedItem="{Binding SelectedQubit}" BorderThickness="0" Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2">
                                            <Ellipse Width="12" Height="12" Fill="{Binding Brush}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="+ Új qubit" Command="{Binding AddQubitCommand}" ToolTip="Új, független qubit a jelenlegi θ, φ kezdőállapottal (max. 6)"/>
                                <Button Content="− Kiválasztott törlése" Command="{Binding RemoveQubitCommand}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                       Text="A kapuk és a mérés mindig a kiválasztott qubitre hatnak. Összefonódott állapot nem ábrázolható egyetlen Bloch-gömbön, ezért a qubitek egymástól függetlenek."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 1. Initial state -->
                    <GroupBox Header="1. Kezdőállapot: |ψ⟩ = cos(θ/2)|0⟩ + e^(jφ)·sin(θ/2)|1⟩">
                        <StackPanel>
                            <Grid Margin="0,0,0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="θ (0–180°)" VerticalAlignment="Center" Foreground="#555"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="180" Value="{Binding InputTheta}" TickFrequency="45" TickPlacement="BottomRight"
                                        VerticalAlignment="Center" Margin="4,0,8,0" SmallChange="1" LargeChange="15"/>
                                <TextBox Grid.Column="2" Text="{Binding InputTheta, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="NumberBox_KeyDown"/>
                            </Grid>
                            <Grid Margin="0,4,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="φ (0–360°)" VerticalAlignment="Center" Foreground="#555"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding InputPhi}" TickFrequency="45" TickPlacement="BottomRight"
                                        VerticalAlignment="Center" Margin="4,0,8,0" SmallChange="1" LargeChange="15"/>
                                <TextBox Grid.Column="2" Text="{Binding InputPhi, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="NumberBox_KeyDown"/>
                            </Grid>

                            <TextBlock Text="Nevezetes állapotok:" Foreground="#555" Margin="0,0,0,2"/>
                            <UniformGrid Columns="6">
                                <Button Content="|0⟩" Command="{Binding PresetCommand}" CommandParameter="|0⟩" ToolTip="θ=0°: északi pólus"/>
                                <Button Content="|1⟩" Command="{Binding PresetCommand}" CommandParameter="|1⟩" ToolTip="θ=180°: déli pólus"/>
                                <Button Content="|+⟩" Command="{Binding PresetCommand}" CommandParameter="|+⟩" ToolTip="H|0⟩ = (|0⟩+|1⟩)/√2"/>
                                <Button Content="|−⟩" Command="{Binding PresetCommand}" CommandParameter="|−⟩" ToolTip="H|1⟩ = (|0⟩−|1⟩)/√2"/>
                                <Button Content="|+j⟩" Command="{Binding PresetCommand}" CommandParameter="|+j⟩" ToolTip="(|0⟩+j|1⟩)/√2"/>
                                <Button Content="|−j⟩" Command="{Binding PresetCommand}" CommandParameter="|−j⟩" ToolTip="(|0⟩−j|1⟩)/√2"/>
                            </UniformGrid>

                            <Button Content="Új kezdőállapot (θ, φ)" Command="{Binding SetInitStateCommand}" Style="{StaticResource AccentButton}" Margin="3,8,3,3"
                                    ToolTip="A kiválasztott qubit láncát újraindítja a beállított θ, φ szögekkel"/>
                            <TextBlock Text="{Binding InputHint}" Foreground="#B06000" TextWrapping="Wrap" Margin="3,2,3,0" FontSize="11.5"/>

                            <Border Background="#FFFFFF" BorderBrush="#E0E0E0" BorderThickness="1" Padding="8" Margin="3,8,3,0">
                                <StackPanel>
                                    <TextBlock Text="Tetszőleges állapot előállítása alapkapukkal (előadás)" FontWeight="SemiBold"/>
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,6"
                                               Text="|0⟩ → H → P(α) → H → P(90°+β) = e^(jα/2)[cos(α/2)|0⟩ + e^(jβ)sin(α/2)|1⟩]. A cél: α = θ, β = φ a fenti csúszkákról."/>
                                    <Button Content="▶ Előállítás lépésenként" Command="{Binding PreparationDemoCommand}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </GroupBox>

                    <!-- 2. Basic gates -->
                    <GroupBox Header="2. Alapkapuk">
                        <UniformGrid Columns="4">
                            <Button Content="X" Command="{Binding ApplyGateCommand}" CommandParameter="X" ToolTip="Pauli-X (bit-flip): [[0, 1], [1, 0]] — 180° az x tengely körül"/>
                            <Button Content="Y" Command="{Binding ApplyGateCommand}" CommandParameter="Y" ToolTip="Pauli-Y: [[0, −j], [j, 0]] — 180° az y tengely körül"/>
                            <Button Content="Z" Command="{Binding ApplyGateCommand}" CommandParameter="Z" ToolTip="Pauli-Z (phase-flip): [[1, 0], [0, −1]] — 180° a z tengely körül"/>
                            <Button Content="H" Command="{Binding ApplyGateCommand}" CommandParameter="H" ToolTip="Hadamard: 1/√2·[[1, 1], [1, −1]] — 180° az (x+z)/√2 tengely körül"/>
                        </UniformGrid>
                    </GroupBox>

                    <!-- 3. Phase gate family -->
                    <GroupBox Header="3. Fáziskapuk és egyéb nevezetes kapuk">
                        <StackPanel>
                            <UniformGrid Columns="5">
                                <Button Content="S" Command="{Binding ApplyGateCommand}" CommandParameter="S" ToolTip="S = P(90°): [[1, 0], [0, j]]"/>
                                <Button Content="S†" Command="{Binding ApplyGateCommand}" CommandParameter="Sdg" ToolTip="S† = P(−90°): [[1, 0], [0, −j]]"/>
                                <Button Content="T" Command="{Binding ApplyGateCommand}" CommandParameter="T" ToolTip="T = P(45°): [[1, 0], [0, e^(jπ/4)]]"/>
                                <Button Content="T†" Command="{Binding ApplyGateCommand}" CommandParameter="Tdg" ToolTip="T† = P(−45°): [[1, 0], [0, e^(−jπ/4)]]"/>
                                <Button Content="√X" Command="{Binding ApplyGateCommand}" CommandParameter="SqrtX" ToolTip="√X = ½·[[1+j, 1−j], [1−j, 1+j]] — 90° az x tengely körül, kétszer alkalmazva X"/>
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Caption}" Margin="3,4,3,0" Text="Az S és T a P(α) fáziskapu speciális esetei (α = 90°, illetve 45°)."/>
                        </StackPanel>
                    </GroupBox>

                    <!-- 4. Parametric gates -->
                    <GroupBox Header="4. Paraméteres kapuk: fázisforgatás és forgatások">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="70"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="α szög (°)" VerticalAlignment="Center" Foreground="#555"/>
                                <Slider Grid.Column="1" Minimum="0" Maximum="360" Value="{Binding InputRotationAngle}" TickFrequency="45" TickPlacement="BottomRight"
                                        VerticalAlignment="Center" Margin="4,0,8,0" SmallChange="1" LargeChange="15"/>
                                <TextBox Grid.Column="2" Text="{Binding InputRotationAngle, UpdateSourceTrigger=LostFocus, StringFormat={}{0:0.##}}" KeyDown="NumberBox_KeyDown"
                                         ToolTip="Negatív érték is megadható (−360…360)"/>
                            </Grid>
                            <UniformGrid Columns="4">
                                <Button Content="P(α)" Command="{Binding ApplyGateCommand}" CommandParameter="P" ToolTip="Fázisforgató kapu: [[1, 0], [0, e^(jα)]] — α forgatás a z tengely körül"/>
                                <Button Content="Rx(α)" Command="{Binding ApplyGateCommand}" CommandParameter="Rx" ToolTip="[[cos(α/2), −j·sin(α/2)], [−j·sin(α/2), cos(α/2)]]"/>
                                <Button Content="Ry(α)" Command="{Binding ApplyGateCommand}" CommandParameter="Ry" ToolTip="[[cos(α/2), −sin(α/2)], [sin(α/2), cos(α/2)]]"/>
                                <Button Content="Rz(α)" Command="{Binding ApplyGateCommand}" CommandParameter="Rz" ToolTip="[[e^(−jα/2), 0], [0, e^(jα/2)]] — globális fázisban tér el P(α)-tól"/>
                            </UniformGrid>
                        </StackPanel>
                    </GroupBox>

                    <!-- 5. Measurement -->
                    <GroupBox Header="5. Mérés (3. posztulátum, projektív mérés)">
                        <StackPanel>
                            <UniformGrid Columns="2">
                                <Button Content="Mérés Z-bázisban {|0⟩, |1⟩}" Command="{Binding MeasureCommand}" CommandParameter="Z"
                                        ToolTip="P₀ = |0⟩⟨0|, P₁ = |1⟩⟨1|. Az állapot a mért bázisállapotba billen."/>
                                <Button Content="Mérés X-bázisban {|+⟩, |−⟩}" Command="{Binding MeasureCommand}" CommandParameter="X"
                                        ToolTip="Mint a BB84-ben: Hadamard-bázisú mérés. Az állapot |+⟩-ba vagy |−⟩-ba billen."/>
                            </UniformGrid>

                            <TextBlock Text="Ismételt mérés (statisztika, az állapot nem változik):" Foreground="#555" Margin="3,10,3,4"/>
                            <StackPanel Orientation="Horizontal" Margin="3,0,3,6">
                                <ComboBox ItemsSource="{Binding ShotOptions}" SelectedItem="{Binding ShotCount}" Width="80" Margin="0,0,10,0"/>
                                <RadioButton Content="Z-bázis" IsChecked="True" GroupName="ShotBasis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton Content="X-bázis" IsChecked="{Binding ShotBasisIsX}" GroupName="ShotBasis" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <Button Content="Futtatás" Command="{Binding RunShotsCommand}" Style="{StaticResource AccentButton}"/>
                            </StackPanel>

                            <Grid Margin="3,4,3,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34"/>
                                    <ColumnDefinition Width="232"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="26"/>
                                    <RowDefinition Height="26"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding HistogramLabel0}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                <Canvas Grid.Column="1" Height="18" VerticalAlignment="Center" Background="#EEEEEE" Width="222" HorizontalAlignment="Left">
                                    <Rectangle Fill="{Binding SelectedQubit.Brush}" Width="{Binding HistogramBar0}" Height="18"/>
                                    <Rectangle Fill="Black" Width="2" Height="22" Canvas.Top="-2" Canvas.Left="{Binding ExpectedMarker0}"/>
                                </Canvas>
                                <TextBlock Grid.Column="2" Text="{Binding HistogramCount0}" VerticalAlignment="Center" FontSize="11.5"/>
                                <TextBlock Grid.Row="1" Text="{Binding HistogramLabel1}" Style="{StaticResource Mono}" VerticalAlignment="Center"/>
                                <Canvas Grid.Row="1" Grid.Column="1" Height="18" VerticalAlignment="Center" Background="#EEEEEE" Width="222" HorizontalAlignment="Left">
                                    <Rectangle Fill="{Binding SelectedQubit.Brush}" Width="{Binding HistogramBar1}" Height="18"/>
                                    <Rectangle Fill="Black" Width="2" Height="22" Canvas.Top="-2" Canvas.Left="{Binding ExpectedMarker1}"/>
                                </Canvas>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding HistogramCount1}" VerticalAlignment="Center" FontSize="11.5"/>
                            </Grid>
                            <TextBlock Text="{Binding HistogramSummary}" Style="{StaticResource Caption}" Margin="3,4,3,0"/>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
